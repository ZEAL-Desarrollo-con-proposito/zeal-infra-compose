{
 "uid": "zeal-overview",
 "title": "ZEAL · Estado de la plataforma",
 "tags": [
  "zeal",
  "OBS-1"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "title": "Estado por componente (réplicas arriba)",
   "type": "stat",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (up)",
     "legendFormat": "{{job}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 2,
   "title": "Alertas activas (OBS-1 / SEG-4)",
   "type": "alertlist",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {
    "showOptions": "current",
    "maxItems": 20,
    "stateFilter": {
     "firing": true,
     "pending": true
    }
   }
  },
  {
   "id": 3,
   "title": "p95 HTTP por servicio",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_requests_seconds_bucket{job=~\"wellbeing|marketplace|realtime\",uri!~\"/actuator.*\"}[2m])))",
     "legendFormat": "{{job}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 4,
   "title": "Errores 5xx (%) por servicio",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 * sum by (job) (rate(http_server_requests_seconds_count{job=~\"wellbeing|marketplace|realtime\",status=~\"5..\"}[2m])) / sum by (job) (rate(http_server_requests_seconds_count{job=~\"wellbeing|marketplace|realtime\"}[2m]))",
     "legendFormat": "{{job}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 5,
   "title": "Peticiones por segundo",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"wellbeing|marketplace|realtime\",uri!~\"/actuator.*\"}[1m]))",
     "legendFormat": "{{job}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 6,
   "title": "Tiempo real: p95 commit → STOMP",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (source, le) (rate(zeal_realtime_delivery_latency_seconds_bucket[2m])))",
     "legendFormat": "{{source}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 7,
   "title": "Conexiones WebSocket",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (instance) (zeal_realtime_websocket_sessions)",
     "legendFormat": "{{instance}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum(zeal_business_users_active)",
     "legendFormat": "personas conectadas",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 8,
   "title": "Negocio (última hora)",
   "type": "stat",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (increase(zeal_business_appointments_total[1h]))",
     "legendFormat": "citas {{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "B",
     "expr": "sum by (status) (increase(zeal_business_applications_total[1h]))",
     "legendFormat": "postulaciones {{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "C",
     "expr": "sum(increase(zeal_business_workshop_enrollments_total[1h]))",
     "legendFormat": "inscripciones",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "D",
     "expr": "sum(increase(zeal_business_freed_slots_taken_total[1h]))",
     "legendFormat": "cupos liberados tomados",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "E",
     "expr": "sum(increase(zeal_business_logins_total[1h]))",
     "legendFormat": "inicios de sesión",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    },
    {
     "refId": "F",
     "expr": "sum(increase(zeal_business_chat_messages_total[1h]))",
     "legendFormat": "mensajes de chat",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 9,
   "title": "Frontend: errores por tipo",
   "type": "timeseries",
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (rate(zeal_frontend_errors_total[5m]))",
     "legendFormat": "{{name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 10,
   "title": "Seguridad: sesiones revocadas por reutilización",
   "type": "timeseries",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 6
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(zeal_security_refresh_reuse_total[5m]))",
     "legendFormat": "revocadas",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "id": 11,
   "title": "Logs de error (JSON, sin datos personales)",
   "type": "logs",
   "gridPos": {
    "x": 0,
    "y": 38,
    "w": 24,
    "h": 10
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service=~\"wellbeing|marketplace|realtime|business-metrics\"} | json | level=~\"ERROR|WARN\"",
     "legendFormat": "",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
}