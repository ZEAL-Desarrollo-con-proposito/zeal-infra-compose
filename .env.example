# Entorno LOCAL (docker-compose.yml). Copia como .env solo si quieres cambiar algo: todos tienen
# valores por defecto de desarrollo. NUNCA uses estos valores en un despliegue real.

# Réplicas de cada microservicio (HU-BE-19 pide al menos 2).
SERVICE_REPLICAS=2

# Bases de datos (desarrollo). POSTGRES_* es el propietario (migraciones); DB_APP_* el usuario de la
# aplicación, que la migración crea sin DDL ni UPDATE/DELETE sobre security_audit (R2-14).
POSTGRES_USER=zeal_user
POSTGRES_PASSWORD=zeal_password
DB_APP_USER=zeal_app
DB_APP_PASSWORD=zeal_app_dev_password

# Login (R2-17): proveedor OIDC de prueba en http://localhost:8090 y SPA en FRONTEND_URL
OIDC_CLIENT_SECRET=zeal-local-secret
FRONTEND_URL=http://localhost:3000

# Firma de los JWT (solo desarrollo; las pruebas de carga firman con este mismo valor)
JWT_SECRET=ZealMVP2026ArchitectureSoftwareSecretKeyMinimum256Bits!!

# RabbitMQ (broker STOMP del Real-Time Gateway)
RABBITMQ_USER=zeal
RABBITMQ_PASSWORD=zeal-dev-password

# LiveKit (talleres y citas 1:1)
LIVEKIT_API_KEY=zeal-dev
LIVEKIT_API_SECRET=ZealLiveKitDevSecretKeyMinimum32Chars!!

# coturn (relé TURN permanente). El mismo secreto lo usan coturn, wellbeing y LiveKit.
TURN_SECRET=ZealTurnDevSecretOnlyForLocal
TURN_TLS_PORT=5349
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp,turns:localhost:5349?transport=tcp

APP_TIME_ZONE=America/Bogota
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEMO_DATA_ENABLED=true
ROOM_ICE_SERVERS=stun:stun.l.google.com:19302
