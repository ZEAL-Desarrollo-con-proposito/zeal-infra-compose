# Balanceador del nodo de BORDE (R2-2, R2-4). Plantilla: la imagen oficial de NGINX la procesa con envsubst
# al arrancar (NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx) y solo reemplaza las variables definidas en el entorno.
#
# Cada microservicio (wellbeing, marketplace, realtime) y el frontend viven en DOS máquinas virtuales
# distintas: la 1 y la 2. El balanceador reparte con least_conn entre las dos y, si una VM se apaga o deja
# de responder, la saca de la rotación (max_fails/fail_timeout) y manda todo a la otra, sin intervención.
#   · UPSTREAM_2_FLAG vacío   → las dos reciben tráfico (activo-activo: reparte carga y tolera la caída).
#   · UPSTREAM_2_FLAG=backup  → la VM 2 es un respaldo estricto: solo recibe tráfico si la 1 falla
#                               (excepto los WebSockets, que usan hash y NGINX no admite backup con hash).
# *_1_HOST y *_2_HOST son la IP (o el nombre DNS) de cada VM, sin puerto; FRONTEND_PORT es el puerto del front (80
# con una VM por servicio; 3080 cuando comparte máquina con Caddy, que ocupa el 80).
worker_processes auto;

events {
    worker_connections 4096;
}

http {
    server_tokens off;
    
    include /etc/nginx/conf.d/zeal-common.conf;
    access_log /dev/stdout zeal_json;
    error_log /dev/stderr warn;

    upstream wellbeing {
        zone wellbeing 64k;
        least_conn;
        server ${WELLBEING_1_HOST}:8081 max_fails=3 fail_timeout=10s;
        server ${WELLBEING_2_HOST}:8081 max_fails=3 fail_timeout=10s ${UPSTREAM_2_FLAG};
        keepalive 32;
    }
    upstream marketplace {
        zone marketplace 64k;
        least_conn;
        server ${MARKETPLACE_1_HOST}:8082 max_fails=3 fail_timeout=10s;
        server ${MARKETPLACE_2_HOST}:8082 max_fails=3 fail_timeout=10s ${UPSTREAM_2_FLAG};
        keepalive 32;
    }
    upstream realtime {
        zone realtime 64k;
        least_conn;
        server ${REALTIME_1_HOST}:8083 max_fails=3 fail_timeout=10s;
        server ${REALTIME_2_HOST}:8083 max_fails=3 fail_timeout=10s ${UPSTREAM_2_FLAG};
        keepalive 16;
    }
    upstream realtime_ws {
        zone realtime_ws 64k;
        hash $sockjs_session;   # DT-3: afinidad por id de sesión SockJS (ver nginx.conf)
        server ${REALTIME_1_HOST}:8083 max_fails=3 fail_timeout=10s;
        # Sin ${UPSTREAM_2_FLAG}: NGINX no admite "backup" con "hash". Las sesiones de WebSocket/SockJS se reparten por
        # id de sesión entre las dos VMs aunque el resto esté en modo respaldo; si una VM cae, sus sesiones pasan
        # a la otra y el navegador reconecta solo.
        server ${REALTIME_2_HOST}:8083 max_fails=3 fail_timeout=10s;
    }
    upstream livekit {
        zone livekit 64k;
        server ${LIVEKIT_HOST}:7880;
    }
    upstream frontend {
        zone frontend 64k;
        server ${FRONTEND_1_HOST}:${FRONTEND_PORT} max_fails=3 fail_timeout=10s;
        server ${FRONTEND_2_HOST}:${FRONTEND_PORT} max_fails=3 fail_timeout=10s ${UPSTREAM_2_FLAG};
    }

    server {
        listen 8080;
        include /etc/nginx/conf.d/zeal-routes.conf;

        location / {
            include /etc/nginx/conf.d/zeal-proxy-headers.inc;
            proxy_pass http://frontend;
        }
    }
}
