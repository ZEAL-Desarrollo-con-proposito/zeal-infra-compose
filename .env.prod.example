# Copia este archivo como .env.prod y completa los valores. Nunca subas .env.prod al repositorio.

# Dominio público. Con un dominio real Caddy emite el certificado HTTPS automáticamente
# (el DNS debe apuntar a la IP del servidor y los puertos 80/443 deben estar abiertos).
# Sin dominio propio sirve <IP-con-guiones>.sslip.io, p. ej. 203-0-113-10.sslip.io
SITE_ADDRESS=zeal.midominio.com
PUBLIC_URL=https://zeal.midominio.com

# Secretos: genera cada uno con `openssl rand -base64 48`.
JWT_SECRET=
WELLBEING_DB_PASSWORD=
MARKETPLACE_DB_PASSWORD=
# Broker STOMP del Real-Time Gateway (RabbitMQ). Genera la contraseña con `openssl rand -hex 24`.
RABBITMQ_USER=zeal
RABBITMQ_PASSWORD=

# Videollamadas grupales de los talleres (LiveKit). Genera el secreto con `openssl rand -hex 32`.
# Abre en el firewall de la VM: 7881/tcp y 50000-50100/udp.
LIVEKIT_API_KEY=zeal
LIVEKIT_API_SECRET=

# Login con Microsoft Entra ID (R2-17). Redirect URI a registrar: https://<dominio>/api/auth/microsoft/callback
OIDC_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Datos de demostración (citas, convocatorias y talleres con fechas relativas al arranque).
DEMO_DATA_ENABLED=true
APP_TIME_ZONE=America/Bogota

# Videollamadas (HU-DT-02): STUN público y relé coturn PERMANENTE con credenciales temporales.
# TURN_SECRET lo comparten coturn, wellbeing y LiveKit (genera con `openssl rand -hex 32`).
# Abre en el firewall: 3478/udp+tcp, TURN_TLS_PORT/tcp y 49160-49200/udp.
ROOM_ICE_SERVERS=stun:stun.l.google.com:19302
TURN_SECRET=
TURN_DOMAIN=zeal.midominio.com
TURN_TLS_PORT=5349
TURN_URLS=turn:zeal.midominio.com:3478?transport=udp,turn:zeal.midominio.com:3478?transport=tcp,turns:zeal.midominio.com:5349?transport=tcp
# Carpeta con turn.crt y turn.key del dominio (legibles por el usuario nobody del contenedor).
TURN_CERT_DIR=./coturn/certs
PUBLIC_IP=

# Puertos publicados por Caddy.
HTTP_PORT=80
HTTPS_PORT=443
