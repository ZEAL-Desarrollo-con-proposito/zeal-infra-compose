# Nodo de servicios. Copiar como /opt/zeal/.env en services-1 y services-2 (cambia NODE_NAME y PRIVATE_IP).
NODE_NAME=services-1
PRIVATE_IP=10.20.2.4
DATA_NODE_IP=10.20.3.4
PUBLIC_URL=https://zeal.midominio.com

# Imágenes (GitHub Container Registry). El pipeline fija *_TAG al SHA desplegado.
REGISTRY=ghcr.io
GHCR_OWNER=organizacion-del-equipo
WELLBEING_TAG=latest
MARKETPLACE_TAG=latest
REALTIME_TAG=latest

# Secretos (iguales en los dos nodos de servicios). Generar con `openssl rand -base64 48`.
JWT_SECRET=
REDIS_PASSWORD=
RABBITMQ_USER=zeal
RABBITMQ_PASSWORD=
# R2-14: usuario propietario (migraciones) y usuario de la aplicación (sin DDL, sin UPDATE/DELETE en auditoría)
WELLBEING_DB_OWNER_USER=zeal_owner
WELLBEING_DB_OWNER_PASSWORD=
WELLBEING_DB_APP_USER=zeal_app
WELLBEING_DB_APP_PASSWORD=
MARKETPLACE_DB_OWNER_USER=zeal_owner
MARKETPLACE_DB_OWNER_PASSWORD=
MARKETPLACE_DB_APP_USER=zeal_app
MARKETPLACE_DB_APP_PASSWORD=

# Medios (nodo de medios)
TURN_URLS=turn:turn.zeal.midominio.com:3478?transport=udp,turn:turn.zeal.midominio.com:3478?transport=tcp,turns:turn.zeal.midominio.com:443?transport=tcp
TURN_SECRET=
LIVEKIT_API_KEY=zeal
LIVEKIT_API_SECRET=

# Login con Microsoft (R2-17). Cowork: registrar la app en Entra ID.
OIDC_ISSUER_URI=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

DEMO_DATA_ENABLED=false
