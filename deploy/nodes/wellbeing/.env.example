# VM de wellbeing (principal o respaldo). Copiar como /opt/zeal/.env junto al docker-compose.yml de esta carpeta.
# El respaldo usa EL MISMO archivo con NODE_NAME=wellbeing-2 y su propia PRIVATE_IP.
NODE_NAME=wellbeing-1
# IP privada PROPIA de esta VM (az vm show -d ... --query privateIps): donde se publica el puerto
PRIVATE_IP=10.20.0.4
# IP de la VM de datos (la pública si las VMs están en cuentas distintas)
DATA_NODE_IP=10.20.3.4
PUBLIC_URL=https://zeal.midominio.com
REGISTRY=ghcr.io
GHCR_OWNER=organizacion-del-equipo
IMAGE_TAG=latest

JWT_SECRET=
REDIS_PASSWORD=
# R2-14: propietario (migraciones) y usuario de la aplicación de la base de wellbeing
DB_OWNER_USER=zeal_owner
DB_OWNER_PASSWORD=
DB_APP_USER=zeal_app
DB_APP_PASSWORD=

# Medios (VM de medios)
TURN_URLS=turn:turn.zeal.midominio.com:3478?transport=udp,turn:turn.zeal.midominio.com:3478?transport=tcp,turns:turn.zeal.midominio.com:443?transport=tcp
TURN_SECRET=
LIVEKIT_API_KEY=zeal
LIVEKIT_API_SECRET=

# Login con Microsoft Entra ID (R2-17)
OIDC_ISSUER_URI=https://login.microsoftonline.com/TENANT_ID/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

DEMO_DATA_ENABLED=false
