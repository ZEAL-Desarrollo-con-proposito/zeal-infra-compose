# VM de marketplace (principal o respaldo). Copiar como /opt/zeal/.env junto al docker-compose.yml de esta carpeta.
# El respaldo usa EL MISMO archivo con NODE_NAME=marketplace-2 y su propia PRIVATE_IP.
NODE_NAME=marketplace-1
# IP privada PROPIA de esta VM (az vm show -d ... --query privateIps): donde se publica el puerto
PRIVATE_IP=10.20.0.4
# IP de la VM de datos (la pública si las VMs están en cuentas distintas)
DATA_NODE_IP=10.20.3.4
PUBLIC_URL=https://zeal.midominio.com
REGISTRY=ghcr.io
GHCR_OWNER=organizacion-del-equipo
IMAGE_TAG=latest

JWT_SECRET=
REDIS_PASSWORD=
# Propietario (migraciones) y usuario de la aplicación de la base de marketplace
DB_OWNER_USER=zeal_owner
DB_OWNER_PASSWORD=
DB_APP_USER=zeal_app
DB_APP_PASSWORD=
DB_POOL_SIZE=10

LIVEKIT_API_KEY=zeal
LIVEKIT_API_SECRET=
DEMO_DATA_ENABLED=false
