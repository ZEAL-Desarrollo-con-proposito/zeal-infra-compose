# VM de realtime-gateway. Copiar como /opt/zeal/.env (junto al docker-compose.yml de esta carpeta).
# IP privada PROPIA de esta VM (az vm show -d ... --query privateIps): donde se publica el puerto
NODE_NAME=realtime-1
PRIVATE_IP=10.20.0.4
# IP de la VM de datos (la pública si las VMs están en cuentas distintas)
DATA_NODE_IP=10.20.3.4
# IP de la VM de borde: el realtime-gateway consulta a wellbeing a través de su balanceador
EDGE_NODE_IP=10.20.0.4
PUBLIC_URL=https://zeal.midominio.com
REGISTRY=ghcr.io
GHCR_OWNER=organizacion-del-equipo
IMAGE_TAG=latest

JWT_SECRET=
REDIS_PASSWORD=
RABBITMQ_USER=zeal
RABBITMQ_PASSWORD=
REPLICA_MEM=768m
