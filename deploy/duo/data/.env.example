# Capa de DATOS de UNA máquina. Copiar como .env junto a docker-compose.yml.
# Máquina B (primaria):  COMPOSE_PROFILES=primary
# Máquina A (réplica):   COMPOSE_PROFILES=replica  y  PRIMARY_HOST=<IP pública de B>
COMPOSE_PROFILES=primary
PRIVATE_IP=10.20.0.4
# Solo en la réplica: IP (pública) de la máquina primaria
PRIMARY_HOST=

WELLBEING_DB_OWNER_USER=zeal_owner
WELLBEING_DB_OWNER_PASSWORD=
WELLBEING_DB_APP_USER=zeal_app
WELLBEING_DB_APP_PASSWORD=
MARKETPLACE_DB_OWNER_USER=zeal_owner
MARKETPLACE_DB_OWNER_PASSWORD=
MARKETPLACE_DB_APP_USER=zeal_app
MARKETPLACE_DB_APP_PASSWORD=
# Rol con el que la réplica copia los cambios del primario
REPL_USER=replicator
REPL_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=zeal
RABBITMQ_PASSWORD=
# Respaldos (deploy/scripts/backup/pg-backup.sh)
BACKUP_DIR=/var/backups/zeal
BACKUP_RETENTION_DAYS=14
