# Capa de APLICACIÓN de UNA máquina. Copiar como .env junto a docker-compose.yml. La máquina A y la B usan el
# mismo archivo: cambian MACHINE, PRIVATE_IP, PEER_IP y (si cambia el primario de datos) DATA_HOST.
# Los secretos (JWT, contraseñas, OIDC) deben ser IGUALES en las dos máquinas.
MACHINE=a
# IP privada de ESTA máquina (az vm show -d ... --query privateIps): donde se publican los puertos
PRIVATE_IP=10.20.0.4
# IP PÚBLICA (estática) de la OTRA máquina: el balanceador reparte también hacia ella
PEER_IP=
# Donde corren las bases (PostgreSQL, Redis, RabbitMQ). Inicialmente la máquina B: en B, su IP privada;
# en A, la IP pública de B. Tras un failover, promote.sh lo cambia solo.
DATA_HOST=
# LiveKit/coturn y monitoreo (máquina B): en B su IP privada; en A la IP pública de B
MEDIA_HOST=
MONITORING_HOST=

SITE_ADDRESS=zeal.midominio.com
PUBLIC_URL=https://zeal.midominio.com
REGISTRY=ghcr.io
GHCR_OWNER=organizacion-del-equipo
# Etiqueta de cada imagen (deploy-service.sh la actualiza sola en cada despliegue)
WELLBEING_TAG=latest
MARKETPLACE_TAG=latest
REALTIME_TAG=latest
FRONTEND_TAG=latest
REPLICA_MEM=768m
DB_POOL_SIZE=10

# Vacío: las dos máquinas reciben tráfico (activo-activo). backup: la otra solo entra cuando ésta falla.
UPSTREAM_2_FLAG=
# SEG-1: clave con la que el balanceador consulta a CrowdSec (openssl rand -hex 24; distinta en cada máquina)
CROWDSEC_BOUNCER_KEY=

JWT_SECRET=
REDIS_PASSWORD=
RABBITMQ_USER=zeal
RABBITMQ_PASSWORD=
WELLBEING_DB_OWNER_USER=zeal_owner
WELLBEING_DB_OWNER_PASSWORD=
WELLBEING_DB_APP_USER=zeal_app
WELLBEING_DB_APP_PASSWORD=
MARKETPLACE_DB_OWNER_USER=zeal_owner
MARKETPLACE_DB_OWNER_PASSWORD=
MARKETPLACE_DB_APP_USER=zeal_app
MARKETPLACE_DB_APP_PASSWORD=

# Medios (máquina B)
TURN_URLS=turn:turn.zeal.midominio.com:3478?transport=udp,turn:turn.zeal.midominio.com:3478?transport=tcp,turns:turn.zeal.midominio.com:5349?transport=tcp
TURN_SECRET=
LIVEKIT_API_KEY=zeal
LIVEKIT_API_SECRET=

# Login con Microsoft Entra ID (R2-17)
OIDC_ISSUER_URI=https://login.microsoftonline.com/TENANT_ID/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

DEMO_DATA_ENABLED=false
